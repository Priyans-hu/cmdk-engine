{
  "name": "cmdk-engine",
  "version": "0.3.0",
  "description": "The smart command palette engine for React. Built on cmdk. Auto-discover routes, fuzzy search with synonyms, RBAC filtering, frecency ranking, CLI tooling.",
  "license": "MIT",
  "author": "Priyanshu <gargpriyanshu2004@gmail.com> (https://github.com/Priyans-hu)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Priyans-hu/cmdk-engine.git"
  },
  "homepage": "https://priyans-hu.github.io/cmdk-engine",
  "bugs": {
    "url": "https://github.com/Priyans-hu/cmdk-engine/issues"
  },
  "keywords": [
    "command-palette",
    "cmdk",
    "command-menu",
    "cmd-k",
    "ctrl-k",
    "headless",
    "react",
    "nextjs",
    "command-bar",
    "fuzzy-search",
    "rbac",
    "frecency",
    "route-discovery",
    "keyboard-shortcuts",
    "spotlight",
    "kbar",
    "react-command-palette",
    "search-ui",
    "accessibility",
    "command-line",
    "cli",
    "sitemap",
    "route-scanner"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "cmdk-engine": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./adapters/cmdk": {
      "types": "./dist/adapters/cmdk/index.d.ts",
      "import": "./dist/adapters/cmdk/index.js",
      "require": "./dist/adapters/cmdk/index.cjs"
    },
    "./adapters/react-router": {
      "types": "./dist/adapters/react-router/index.d.ts",
      "import": "./dist/adapters/react-router/index.js",
      "require": "./dist/adapters/react-router/index.cjs"
    },
    "./search/match-sorter": {
      "types": "./dist/core/search-match-sorter.d.ts",
      "import": "./dist/core/search-match-sorter.js",
      "require": "./dist/core/search-match-sorter.cjs"
    }
  },
  "main": "./dist/core/index.cjs",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish",
    "prepublishOnly": "bun run build",
    "build:binary": "bun run build && bun build dist/cli/index.js --compile --outfile dist/cmdk-engine",
    "size": "size-limit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "path": "dist/core/index.js",
      "limit": "4.5 KB"
    },
    {
      "path": "dist/react/index.js",
      "limit": "4 KB",
      "ignore": ["react", "react-dom"]
    },
    {
      "path": "dist/adapters/cmdk/index.js",
      "limit": "3 KB",
      "ignore": ["cmdk", "react", "react-dom"]
    }
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29",
    "@size-limit/preset-small-lib": "^12.0",
    "@testing-library/jest-dom": "^6.6",
    "@testing-library/react": "^16.1",
    "@types/node": "^25.1.0",
    "@types/react": "^19.0",
    "@types/react-dom": "^19.0",
    "@typescript-eslint/eslint-plugin": "^8.0",
    "@typescript-eslint/parser": "^8.0",
    "@vitest/coverage-v8": "^4.0.18",
    "cmdk": "^1.1",
    "commander": "^14.0",
    "eslint": "^10.0",
    "jsdom": "^28.0",
    "match-sorter": "^8.0",
    "prettier": "^3.5",
    "react-router": "^7.0",
    "react-router-dom": "^7.0",
    "size-limit": "^12.0",
    "tsup": "^8.5",
    "typescript": "^6.0",
    "vitest": "^4.0"
  }
}
