{
  "name": "cmdk-engine",
  "version": "0.6.0",
  "description": "Permission-aware command palette engine for React. Works with cmdk or Base UI. Auto-discover routes, fuzzy search with synonyms, RBAC filtering, frecency ranking, CLI tooling.",
  "license": "MIT",
  "author": "Priyanshu <gargpriyanshu2004@gmail.com> (https://github.com/Priyans-hu)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Priyans-hu/cmdk-engine.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://priyans-hu.github.io/cmdk-engine",
  "bugs": {
    "url": "https://github.com/Priyans-hu/cmdk-engine/issues"
  },
  "keywords": [
    "command-palette",
    "cmdk",
    "base-ui",
    "shadcn",
    "command-menu",
    "cmd-k",
    "ctrl-k",
    "headless",
    "react",
    "nextjs",
    "command-bar",
    "fuzzy-search",
    "rbac",
    "frecency",
    "route-discovery",
    "keyboard-shortcuts",
    "spotlight",
    "kbar",
    "react-command-palette",
    "search-ui",
    "accessibility",
    "command-line",
    "cli",
    "sitemap",
    "route-scanner"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "cmdk-engine": "dist/cli/index.cjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./adapters/cmdk": {
      "import": {
        "types": "./dist/adapters/cmdk/index.d.ts",
        "default": "./dist/adapters/cmdk/index.js"
      },
      "require": {
        "types": "./dist/adapters/cmdk/index.d.cts",
        "default": "./dist/adapters/cmdk/index.cjs"
      }
    },
    "./adapters/base-ui": {
      "import": {
        "types": "./dist/adapters/base-ui/index.d.ts",
        "default": "./dist/adapters/base-ui/index.js"
      },
      "require": {
        "types": "./dist/adapters/base-ui/index.d.cts",
        "default": "./dist/adapters/base-ui/index.cjs"
      }
    },
    "./adapters/react-router": {
      "import": {
        "types": "./dist/adapters/react-router/index.d.ts",
        "default": "./dist/adapters/react-router/index.js"
      },
      "require": {
        "types": "./dist/adapters/react-router/index.d.cts",
        "default": "./dist/adapters/react-router/index.cjs"
      }
    },
    "./search/match-sorter": {
      "import": {
        "types": "./dist/core/search-match-sorter.d.ts",
        "default": "./dist/core/search-match-sorter.js"
      },
      "require": {
        "types": "./dist/core/search-match-sorter.d.cts",
        "default": "./dist/core/search-match-sorter.cjs"
      }
    },
    "./adapters/sitemap": {
      "import": {
        "types": "./dist/adapters/sitemap/index.d.ts",
        "default": "./dist/adapters/sitemap/index.js"
      },
      "require": {
        "types": "./dist/adapters/sitemap/index.d.cts",
        "default": "./dist/adapters/sitemap/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/core/index.cjs",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ],
      "adapters/cmdk": [
        "./dist/adapters/cmdk/index.d.ts"
      ],
      "adapters/base-ui": [
        "./dist/adapters/base-ui/index.d.ts"
      ],
      "adapters/react-router": [
        "./dist/adapters/react-router/index.d.ts"
      ],
      "search/match-sorter": [
        "./dist/core/search-match-sorter.d.ts"
      ],
      "adapters/sitemap": [
        "./dist/adapters/sitemap/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:dist": "node tests-dist/node-esm.mjs && node tests-dist/node-cjs.cjs && vitest run --config vitest.dist.config.ts && vitest run --config vitest.dist.floor.config.ts",
    "lint": "eslint src/ tests/ tests-dist/",
    "lint:package": "publint --strict && attw --pack .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish",
    "prepublishOnly": "bun run build",
    "build:binary": "bun run build && bun build dist/cli/index.cjs --compile --outfile dist/cmdk-engine",
    "size": "size-limit"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.1.0",
    "cmdk": "^1.0.0",
    "match-sorter": "^7.0.0 || ^8.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    },
    "cmdk": {
      "optional": true
    },
    "match-sorter": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "name": "cmdk-engine",
      "path": "dist/core/index.js",
      "limit": "3.81 KB"
    },
    {
      "name": "cmdk-engine/react (own code)",
      "path": "dist/react/index.js",
      "limit": "4.51 KB",
      "ignore": [
        "cmdk-engine",
        "react",
        "react-dom"
      ]
    },
    {
      "name": "cmdk-engine/adapters/cmdk (own code)",
      "path": "dist/adapters/cmdk/index.js",
      "limit": "1.86 KB",
      "ignore": [
        "cmdk-engine",
        "cmdk",
        "react",
        "react-dom"
      ]
    },
    {
      "name": "cmdk-engine/adapters/react-router",
      "path": "dist/adapters/react-router/index.js",
      "limit": "1.17 KB"
    },
    {
      "name": "cmdk-engine/search/match-sorter",
      "path": "dist/core/search-match-sorter.js",
      "limit": "0.57 KB"
    },
    {
      "name": "cmdk-engine/adapters/base-ui (own code)",
      "path": "dist/adapters/base-ui/index.js",
      "limit": "1.83 KB",
      "ignore": [
        "cmdk-engine",
        "@base-ui/react",
        "react",
        "react-dom"
      ]
    },
    {
      "name": "Quick Start stack",
      "import": {
        "dist/react/index.js": "{ CommandEngineProvider, useCommandRegister }",
        "dist/adapters/cmdk/index.js": "{ CommandPalette, useCommandPaletteShortcut }"
      },
      "limit": "8.41 KB"
    },
    {
      "name": "cmdk-engine/adapters/sitemap",
      "path": "dist/adapters/sitemap/index.js",
      "limit": "0.24 KB"
    }
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@base-ui/react": "^1.8.0",
    "@changesets/cli": "^2.29",
    "@size-limit/preset-small-lib": "^12.0",
    "@testing-library/jest-dom": "^6.6",
    "@testing-library/react": "^16.1",
    "@types/node": "^25.1.0",
    "@types/react": "^19.0",
    "@types/react-dom": "^19.0",
    "@typescript-eslint/eslint-plugin": "^8.0",
    "@typescript-eslint/parser": "^8.0",
    "@vitest/coverage-v8": "^4.0.18",
    "base-ui-floor": "npm:@base-ui/react@1.1.0",
    "cmdk": "^1.1",
    "commander": "^14.0",
    "eslint": "^10.0",
    "jsdom": "^29.1",
    "match-sorter": "^8.0",
    "prettier": "^3.5",
    "publint": "0.3.25",
    "react-router": "^8",
    "react-router-dom": "^7.0",
    "react-router-v6": "npm:react-router@^6",
    "react-router-v7": "npm:react-router@^7",
    "size-limit": "^12.0",
    "tsup": "^8.5",
    "typescript": "^6.0",
    "vitest": "^4.0"
  }
}
