{
  "name": "cmdk-engine",
  "version": "0.5.1",
  "description": "The smart command palette engine for React. Built on cmdk. Auto-discover routes, fuzzy search with synonyms, RBAC filtering, frecency ranking, CLI tooling.",
  "license": "MIT",
  "author": "Priyanshu <gargpriyanshu2004@gmail.com> (https://github.com/Priyans-hu)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Priyans-hu/cmdk-engine.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://priyans-hu.github.io/cmdk-engine",
  "bugs": {
    "url": "https://github.com/Priyans-hu/cmdk-engine/issues"
  },
  "keywords": [
    "command-palette",
    "cmdk",
    "command-menu",
    "cmd-k",
    "ctrl-k",
    "headless",
    "react",
    "nextjs",
    "command-bar",
    "fuzzy-search",
    "rbac",
    "frecency",
    "route-discovery",
    "keyboard-shortcuts",
    "spotlight",
    "kbar",
    "react-command-palette",
    "search-ui",
    "accessibility",
    "command-line",
    "cli",
    "sitemap",
    "route-scanner"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "cmdk-engine": "./dist/cli/index.cjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./adapters/cmdk": {
      "import": {
        "types": "./dist/adapters/cmdk/index.d.ts",
        "default": "./dist/adapters/cmdk/index.js"
      },
      "require": {
        "types": "./dist/adapters/cmdk/index.d.cts",
        "default": "./dist/adapters/cmdk/index.cjs"
      }
    },
    "./adapters/react-router": {
      "import": {
        "types": "./dist/adapters/react-router/index.d.ts",
        "default": "./dist/adapters/react-router/index.js"
      },
      "require": {
        "types": "./dist/adapters/react-router/index.d.cts",
        "default": "./dist/adapters/react-router/index.cjs"
      }
    },
    "./search/match-sorter": {
      "import": {
        "types": "./dist/core/search-match-sorter.d.ts",
        "default": "./dist/core/search-match-sorter.js"
      },
      "require": {
        "types": "./dist/core/search-match-sorter.d.cts",
        "default": "./dist/core/search-match-sorter.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/core/index.cjs",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ],
      "adapters/cmdk": [
        "./dist/adapters/cmdk/index.d.ts"
      ],
      "adapters/react-router": [
        "./dist/adapters/react-router/index.d.ts"
      ],
      "search/match-sorter": [
        "./dist/core/search-match-sorter.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish",
    "prepublishOnly": "bun run build",
    "build:binary": "bun run build && bun build dist/cli/index.cjs --compile --outfile dist/cmdk-engine",
    "size": "size-limit"
  },
  "peerDependencies": {
    "cmdk": "^1.0.0",
    "match-sorter": "^7.0.0 || ^8.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router": "^6.0.0 || ^7.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "cmdk": {
      "optional": true
    },
    "match-sorter": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "path": "dist/core/index.js",
      "limit": "4.5 KB"
    },
    {
      "path": "dist/react/index.js",
      "limit": "4 KB",
      "ignore": [
        "react",
        "react-dom"
      ]
    },
    {
      "path": "dist/adapters/cmdk/index.js",
      "limit": "3 KB",
      "ignore": [
        "cmdk",
        "react",
        "react-dom"
      ]
    }
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29",
    "@size-limit/preset-small-lib": "^13.0",
    "@testing-library/jest-dom": "^6.6",
    "@testing-library/react": "^16.1",
    "@types/node": "^25.1.0",
    "@types/react": "^19.0",
    "@types/react-dom": "^19.0",
    "@typescript-eslint/eslint-plugin": "^8.0",
    "@typescript-eslint/parser": "^8.0",
    "@vitest/coverage-v8": "^4.0.18",
    "cmdk": "^1.1",
    "commander": "^14.0",
    "eslint": "^10.0",
    "jsdom": "^29.1",
    "match-sorter": "^8.0",
    "prettier": "^3.5",
    "react-router": "^7.0",
    "react-router-dom": "^7.0",
    "size-limit": "^12.0",
    "tsup": "^8.5",
    "typescript": "^6.0",
    "vitest": "^4.0"
  }
}
